# Copy to .env and fill in for a real deployment.
DATABASE_URL=postgresql+psycopg://tracker:tracker@db:5432/tracker
BASE_URL=https://conferences.ids.maastrichtuniversity.nl
SECRET_KEY=generate-with-openssl-rand-hex-32

OIDC_ISSUER=https://login.maastrichtuniversity.nl/realms/ids
OIDC_CLIENT_ID=conference-tracker
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# Restrict sign-in to these email domains (comma separated; empty = any).
ALLOWED_EMAIL_DOMAINS=maastrichtuniversity.nl

# These accounts may edit conferences and milestones.
ADMIN_EMAILS=michel.dumontier@maastrichtuniversity.nl
